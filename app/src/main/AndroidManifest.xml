<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
    </queries>

    <!-- آیکون لانچر فقط در Android Studio و به صورت دستی توسط مالک وارد می‌شود.
         هیچ تصویر لوگو یا خروجی Image Asset نباید در GitHub ذخیره شود.
         Gradle منابع محلی ic_launcher را (در صورت وجود) انتخاب می‌کند و در
         کلون بدون لوگو از آیکون پیش‌فرض اندروید استفاده می‌کند.
         LOCAL-ONLY launcher art; never commit launcher/Image Asset files.
         See AGENTS.md and .gitignore. -->
    <application
        android:name=".AdvanceClockApplication"
        android:icon="${launcherIconResource}"
        android:roundIcon="${launcherRoundIconResource}"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AdvanceClock"
        android:usesCleartextTraffic="false">

        <provider android:name=".SafeDocumentProvider" android:authorities="${applicationId}.checkeddocuments"
            android:exported="false" android:grantUriPermissions="true" />
        <provider android:name=".AlarmMediaProvider" android:authorities="${applicationId}.alarmmedia"
            android:exported="false" android:grantUriPermissions="true" />
        <activity android:name=".AlarmAttachmentEditorActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:enableOnBackInvokedCallback="true" android:name=".AlarmPhotoCropActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".AboutActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".SettingsActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".PrayerSettingsActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity
            android:name=".CalendarWidgetConfigActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".TimeToolsWidgetConfigActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".TimeToolsWidgetPickerActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="" />
        <activity android:name=".CompassToolActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity
            android:name=".PrayerTimesWidgetConfigActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity android:name=".SoundPickerActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".PrayerLocationSearchActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".SmartAlarmActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".StopwatchActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".TimerActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".NotificationSettingsActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".WidgetCenterActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".WorldClockWidgetConfigActivity" android:screenOrientation="portrait" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MediaWidgetViewerActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:excludeFromRecents="true" />
        <activity
            android:name=".MediaWidgetConfigActivity"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name=".WidgetSettingsActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity android:name=".AlarmEditorActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".NoForgetEditorActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity
            android:name=".NoteReminderActivity" android:enableOnBackInvokedCallback="true"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />
        <activity
            android:name=".NoForgetQuickAddActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity android:name=".AlarmPreviewActivity" android:screenOrientation="portrait" android:exported="false" />

        <activity
            android:name=".AlarmRingActivity" android:enableOnBackInvokedCallback="true"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity
            android:name=".AdhanRingActivity"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AlarmSoundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".AdhanSoundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".NoForgetSoundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".MediaPreviewJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <service
            android:name=".WorldClockWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <service
            android:name=".PrayerTimesWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <service
            android:name=".CalendarPrayerWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <service
            android:name=".MediaWidgetRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <service
            android:name=".MediaWidgetPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".DateNotificationService"
            android:exported="false" />

        <receiver android:name=".AlarmPreparationReceiver" android:exported="false" />
        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <receiver android:name=".WidgetPinnedReceiver" android:exported="false" />
        <receiver android:name=".ToolAlarmReceiver" android:exported="false" />
        <receiver android:name=".AlarmReminderReceiver" android:exported="false" />
        <receiver android:name=".AlertSnoozeReceiver" android:exported="false" />
        <receiver android:name=".AlarmSnoozeReceiver" android:exported="false" />
        <receiver android:name=".AdhanReceiver" android:exported="false" />
        <receiver android:name=".StopAlarmReceiver" android:exported="false" />
        <receiver android:name=".NoForgetReminderReceiver" android:exported="false" />
        <receiver android:name=".MediaWidgetActionReceiver" android:exported="false" />

        <receiver android:name=".DateNotificationRefreshReceiver" android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Protected system broadcasts only; receive clock edits while no activity is open. -->
        <receiver android:name=".SystemTimeChangedReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".WorldClockWidgetProvider"
            android:enabled="true"
            android:exported="false"
            android:label="@string/world_clock_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/world_clock_widget_info" />
        </receiver>

        <receiver
            android:name=".PrayerTimesWidgetProvider"
            android:enabled="true"
            android:exported="false"
            android:label="@string/prayer_times_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_times_widget_info" />
        </receiver>

        <receiver
            android:name=".CalendarWidgetProvider"
            android:enabled="true"
            android:exported="false"
            android:label="@string/calendar_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>

        <receiver
            android:name=".TimeToolsWidgetProvider"
            android:enabled="true"
            android:exported="false"
            android:label="@string/time_tools_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/time_tools_widget_info" />
        </receiver>

        <receiver
            android:name=".ClockWidgetProvider"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_widget_info" />
        </receiver>

        <receiver
            android:name=".NoForgetWidgetProvider"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/noforget_widget_info" />
        </receiver>

        <receiver
            android:name=".MediaWidgetProvider"
            android:enabled="true"
            android:exported="false"
            android:label="@string/media_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/media_widget_info" />
        </receiver>

    </application>
</manifest>
