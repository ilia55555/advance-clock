<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/world_item_root"
    android:layout_width="match_parent"
    android:layout_height="122dp"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="1dp">
    <TextView
        android:id="@+id/world_item_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="19sp" />
    <TextClock
        android:id="@+id/world_item_time"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:autoSizeMaxTextSize="105sp"
        android:autoSizeMinTextSize="72sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="105sp"
        android:textStyle="normal"
        android:fontFamily="sans-serif-light"
        android:textScaleX="1.0" />
    <TextClock
        android:id="@+id/world_item_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:format12Hour="EEE, MMM d"
        android:format24Hour="EEE, MMM d"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
