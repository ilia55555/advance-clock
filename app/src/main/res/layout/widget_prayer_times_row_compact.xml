<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_row_root"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="@drawable/widget_prayer_card">

    <TextView
        android:id="@+id/prayer_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center"
        android:text="افقی انتخاب نشده • برای افزودن لمس کنید"
        android:textColor="#F2F8FF"
        android:textSize="10sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/prayer_widget_content"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="21dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/prayer_widget_city"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:textColor="#F2F8FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/prayer_widget_pin"
                android:layout_width="18dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⌖"
                android:textColor="#56D8FF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/prayer_widget_current_chip"
                android:layout_width="wrap_content"
                android:layout_height="19dp"
                android:background="@drawable/widget_prayer_chip"
                android:gravity="center"
                android:minWidth="42dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="فعلی"
                android:textColor="#56D8FF"
                android:textSize="7sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/prayer_widget_next_box"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/prayer_widget_next_label"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <Chronometer
                android:id="@+id/prayer_widget_countdown"
                android:layout_width="0dp"
                android:layout_height="0dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/prayer_widget_times"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="5">

            <LinearLayout android:id="@+id/prayer_time_fajr" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="1dp">
                <TextView android:id="@+id/prayer_icon_fajr" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/prayer_label_fajr" android:layout_width="match_parent" android:layout_height="14dp" android:gravity="center" android:text="فجر" android:textColor="#A9C9E8" android:textSize="7sp" />
                <TextView android:id="@+id/prayer_value_fajr" android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center" android:textColor="#F2F8FF" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/prayer_time_sunrise" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="1dp">
                <TextView android:id="@+id/prayer_icon_sunrise" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/prayer_label_sunrise" android:layout_width="match_parent" android:layout_height="14dp" android:gravity="center" android:text="طلوع" android:textColor="#A9C9E8" android:textSize="7sp" />
                <TextView android:id="@+id/prayer_value_sunrise" android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center" android:textColor="#F2F8FF" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/prayer_time_dhuhr" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="1dp">
                <TextView android:id="@+id/prayer_icon_dhuhr" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/prayer_label_dhuhr" android:layout_width="match_parent" android:layout_height="14dp" android:gravity="center" android:text="ظهر" android:textColor="#A9C9E8" android:textSize="7sp" />
                <TextView android:id="@+id/prayer_value_dhuhr" android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center" android:textColor="#F2F8FF" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/prayer_time_maghrib" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="1dp">
                <TextView android:id="@+id/prayer_icon_maghrib" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/prayer_label_maghrib" android:layout_width="match_parent" android:layout_height="14dp" android:gravity="center" android:text="مغرب" android:textColor="#A9C9E8" android:textSize="7sp" />
                <TextView android:id="@+id/prayer_value_maghrib" android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center" android:textColor="#F2F8FF" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/prayer_time_isha" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="1dp">
                <TextView android:id="@+id/prayer_icon_isha" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/prayer_label_isha" android:layout_width="match_parent" android:layout_height="14dp" android:gravity="center" android:text="عشاء" android:textColor="#A9C9E8" android:textSize="7sp" />
                <TextView android:id="@+id/prayer_value_isha" android:layout_width="match_parent" android:layout_height="18dp" android:gravity="center" android:textColor="#F2F8FF" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
