<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/noforget_row_root"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:layout_marginBottom="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/noforget_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="یادداشت"
            android:textColor="#173F3B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/noforget_row_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="بدون آلارم"
            android:textColor="#758783"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/noforget_row_priority"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="عادی"
        android:textColor="#006666"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>