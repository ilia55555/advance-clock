<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/appBackground"
    android:orientation="vertical"
    android:padding="20dp"
    android:layoutDirection="rtl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/runtime_text_0382"
        android:textColor="?attr/appTextPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/quick_note_text"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_field"
        android:gravity="top|start"
        android:hint="@string/runtime_text_0383"
        android:inputType="textCapSentences|textMultiLine"
        android:padding="12dp"
        android:textColor="?attr/appTextPrimary"
        android:textColorHint="?attr/appTextSecondary" />

    <Spinner
        android:id="@+id/quick_note_priority"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_field"
        android:paddingStart="10dp"
        android:paddingEnd="10dp" />

    <Button
        android:id="@+id/quick_note_save"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_orange_button"
        android:text="@string/runtime_text_0381"
        android:textColor="#FFFFFF"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/quick_note_more"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_soft_button"
        android:text="@string/runtime_text_0384"
        android:textColor="?attr/appPrimary"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/quick_note_cancel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_soft_button"
        android:text="@string/runtime_text_0003"
        android:textColor="?attr/appPrimary"
        android:textAllCaps="false" />
</LinearLayout>