<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adhan_ring_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071B29">

    <FrameLayout
        android:id="@+id/adhan_qibla_background_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="72dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_prayer_time"
            android:textColor="#8ED8D0"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/adhan_ring_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/ui_placeholder_time_hm"
            android:textColor="#FFFFFF"
            android:textSize="76sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/adhan_ring_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/ui_adhan"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/adhan_ring_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="#A8BBC5"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/ui_adhan_key_help"
            android:textColor="#8FA9B7"
            android:textSize="14sp" />

        <Button
            android:id="@+id/adhan_qibla_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_soft_button"
            android:text="@string/prayer_open_qibla"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/adhan_sound_toggle"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_soft_button"
            android:text="@string/ui_mute_completely"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/adhan_stop"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_teal_button"
            android:text="@string/ui_end_adhan"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
