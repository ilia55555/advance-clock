<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adhan_ring_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="24dp"
    android:background="#071B29">

    <TextView
        android:id="@+id/adhan_ring_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/ui_adhan"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/adhan_ring_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/ui_placeholder_time_hm"
        android:textColor="#FFFFFF"
        android:textSize="76sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/adhan_ring_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- This space stays reserved even when the Qibla display is disabled. -->
    <FrameLayout
        android:id="@+id/adhan_qibla_slot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/adhan_qibla_background_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <Button
            android:id="@+id/adhan_qibla_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_soft_button"
            android:text="@string/prayer_open_qibla"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <Button
        android:id="@+id/adhan_sound_toggle"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_soft_button"
        android:text="@string/ui_mute_completely"
        android:textAllCaps="false"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/adhan_stop"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_teal_button"
        android:text="@string/ui_end_adhan"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
