<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ring_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="54dp"
    android:paddingEnd="28dp"
    android:paddingBottom="28dp">

    <TextView
        android:id="@+id/ring_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="امروز"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/ring_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="00:00"
        android:textSize="78sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ring_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="آلارم"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ring_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="زمان زنگ هشدار رسیده است"
        android:textSize="15sp" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/snooze_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:text="یادآوری مجدد بعد از"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/ring_snooze"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_field"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <Button
        android:id="@+id/snooze_alarm"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:text="یادآوری مجدد"
        android:textAllCaps="false"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/stop_alarm"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="10dp"
        android:text="قطع آلارم"
        android:textAllCaps="false"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>