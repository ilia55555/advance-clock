<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="9dp"
    android:background="@drawable/widget_prayer_bg_navy">

    <LinearLayout
        android:id="@+id/prayer_widget_header"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layoutDirection="rtl"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/prayer_widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="اوقات شرعی"
                android:textColor="#F2F8FF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/prayer_widget_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:textColor="#A9C9E8"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/prayer_widget_manage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_prayer_chip"
            android:contentDescription="مدیریت افق‌ها"
            android:gravity="center"
            android:text="⌖"
            android:textColor="#56D8FF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/prayer_widget_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_prayer_chip"
            android:contentDescription="تنظیمات ویجت"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#A9C9E8"
            android:textSize="18sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/prayer_widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:fadingEdge="vertical"
        android:overScrollMode="ifContentScrolls"
        android:paddingBottom="2dp"
        android:scrollbarStyle="insideOverlay"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/prayer_widget_scroll_hint"
        android:layout_width="match_parent"
        android:layout_height="17dp"
        android:gravity="center"
        android:text="↕  اسکرول برای افق‌های بیشتر"
        android:textColor="#7EAACD"
        android:textSize="8sp" />
</LinearLayout>
