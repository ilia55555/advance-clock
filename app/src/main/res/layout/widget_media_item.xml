<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/media_item_root"
    android:layout_width="match_parent"
    android:layout_height="66dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/media_item_preview"
        android:layout_width="64dp"
        android:layout_height="58dp"
        android:background="@android:color/transparent"
        android:contentDescription="پیش‌نمایش"
        android:padding="3dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_note" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/media_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="فایل"
            android:textColor="#173F3B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/media_item_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="نوع فایل"
            android:textColor="#758783"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/media_item_playback"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@android:color/transparent"
        android:contentDescription="پخش یا مکث"
        android:padding="9dp"
        android:src="@drawable/ic_md_play"
        android:visibility="gone" />
</LinearLayout>
