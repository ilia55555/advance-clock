<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:minHeight="88dp"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_prayer_card">

    <TextView
        android:id="@+id/prayer_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:gravity="center"
        android:text="افقی انتخاب نشده • برای افزودن لمس کنید"
        android:textColor="#F2F8FF"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/prayer_widget_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/prayer_widget_city"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:textColor="#F2F8FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/prayer_widget_pin"
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⌖"
                android:textColor="#56D8FF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/prayer_widget_current_chip"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/widget_prayer_chip"
                android:gravity="center"
                android:minWidth="66dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="افق فعلی"
                android:textColor="#56D8FF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/prayer_widget_next_box"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_prayer_next_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/prayer_widget_next_label"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:textColor="#A9C9E8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/prayer_widget_countdown"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFC857"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/prayer_widget_times"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="5">

            <LinearLayout
                android:id="@+id/prayer_time_fajr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">
                <TextView android:id="@+id/prayer_icon_fajr" android:layout_width="match_parent" android:layout_height="16dp" android:gravity="center" android:text="◒" android:textColor="#A9C9E8" android:textSize="12sp" />
                <TextView android:id="@+id/prayer_label_fajr" android:layout_width="match_parent" android:layout_height="15dp" android:gravity="center" android:text="فجر" android:textColor="#A9C9E8" android:textSize="8sp" />
                <TextView android:id="@+id/prayer_value_fajr" android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center" android:textColor="#F2F8FF" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_time_sunrise"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">
                <TextView android:id="@+id/prayer_icon_sunrise" android:layout_width="match_parent" android:layout_height="16dp" android:gravity="center" android:text="☀" android:textColor="#A9C9E8" android:textSize="12sp" />
                <TextView android:id="@+id/prayer_label_sunrise" android:layout_width="match_parent" android:layout_height="15dp" android:gravity="center" android:text="طلوع" android:textColor="#A9C9E8" android:textSize="8sp" />
                <TextView android:id="@+id/prayer_value_sunrise" android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center" android:textColor="#F2F8FF" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_time_dhuhr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">
                <TextView android:id="@+id/prayer_icon_dhuhr" android:layout_width="match_parent" android:layout_height="16dp" android:gravity="center" android:text="☼" android:textColor="#A9C9E8" android:textSize="12sp" />
                <TextView android:id="@+id/prayer_label_dhuhr" android:layout_width="match_parent" android:layout_height="15dp" android:gravity="center" android:text="ظهر" android:textColor="#A9C9E8" android:textSize="8sp" />
                <TextView android:id="@+id/prayer_value_dhuhr" android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center" android:textColor="#F2F8FF" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_time_maghrib"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">
                <TextView android:id="@+id/prayer_icon_maghrib" android:layout_width="match_parent" android:layout_height="16dp" android:gravity="center" android:text="◓" android:textColor="#A9C9E8" android:textSize="12sp" />
                <TextView android:id="@+id/prayer_label_maghrib" android:layout_width="match_parent" android:layout_height="15dp" android:gravity="center" android:text="مغرب" android:textColor="#A9C9E8" android:textSize="8sp" />
                <TextView android:id="@+id/prayer_value_maghrib" android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center" android:textColor="#F2F8FF" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_time_isha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">
                <TextView android:id="@+id/prayer_icon_isha" android:layout_width="match_parent" android:layout_height="16dp" android:gravity="center" android:text="☾" android:textColor="#A9C9E8" android:textSize="12sp" />
                <TextView android:id="@+id/prayer_label_isha" android:layout_width="match_parent" android:layout_height="15dp" android:gravity="center" android:text="عشاء" android:textColor="#A9C9E8" android:textSize="8sp" />
                <TextView android:id="@+id/prayer_value_isha" android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center" android:textColor="#F2F8FF" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
