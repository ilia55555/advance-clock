<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_row_root"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_prayer_card">

    <TextView android:id="@+id/prayer_widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="افقی انتخاب نشده • برای افزودن لمس کنید" android:textColor="#F2F8FF" android:textSize="10sp" android:visibility="gone" />

    <LinearLayout android:id="@+id/prayer_widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="27dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/prayer_widget_city" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="start|center_vertical" android:maxLines="1" android:textColor="#F2F8FF" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/prayer_widget_local_date" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:maxLines="1" android:paddingStart="3dp" android:paddingEnd="3dp" android:textColor="#A9C9E8" android:textSize="9sp" />
            <TextView android:id="@+id/prayer_widget_local_time" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:minWidth="30dp" android:textColor="#56D8FF" android:textSize="10sp" android:textStyle="bold" />
            <Chronometer android:id="@+id/prayer_widget_countdown" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:minWidth="30dp" android:textColor="#FFC857" android:textSize="8sp" android:textStyle="bold" android:visibility="gone" />
            <TextView android:id="@+id/prayer_widget_pin" android:layout_width="28dp" android:layout_height="match_parent" android:contentDescription="تنظیم این افق" android:gravity="center" android:text="⚙" android:textColor="#56D8FF" android:textSize="12sp" />
            <TextView android:id="@+id/prayer_widget_current_chip" android:layout_width="match_parent" android:layout_height="14dp" android:gravity="center" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/prayer_widget_next_box" android:layout_width="match_parent" android:layout_height="0dp" android:visibility="gone">
            <TextView android:id="@+id/prayer_widget_next_label" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/prayer_widget_times" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:orientation="horizontal" android:weightSum="5">
            <LinearLayout android:id="@+id/prayer_time_fajr" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="1dp">
                <TextView android:id="@+id/prayer_icon_fajr" android:text="◒" android:textColor="#A9C9E8" android:textSize="12sp" android:layout_width="match_parent" android:layout_height="14dp" android:gravity="center" android:visibility="gone" />
                <TextView android:id="@+id/prayer_label_fajr" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="فجر" android:textColor="#A9C9E8" android:textSize="8sp" />
                <TextView android:id="@+id/prayer_value_fajr" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#F2F8FF" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_time_sunrise" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="1dp">
                <TextView android:id="@+id/prayer_icon_sunrise" android:text="☀" android:textColor="#A9C9E8" android:textSize="12sp" android:layout_width="match_parent" android:layout_height="14dp" android:gravity="center" android:visibility="gone" />
                <TextView android:id="@+id/prayer_label_sunrise" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="طلوع" android:textColor="#A9C9E8" android:textSize="8sp" />
                <TextView android:id="@+id/prayer_value_sunrise" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#F2F8FF" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_time_dhuhr" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="1dp">
                <TextView android:id="@+id/prayer_icon_dhuhr" android:text="☼" android:textColor="#A9C9E8" android:textSize="12sp" android:layout_width="match_parent" android:layout_height="14dp" android:gravity="center" android:visibility="gone" />
                <TextView android:id="@+id/prayer_label_dhuhr" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="ظهر" android:textColor="#A9C9E8" android:textSize="8sp" />
                <TextView android:id="@+id/prayer_value_dhuhr" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#F2F8FF" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_time_maghrib" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="1dp">
                <TextView android:id="@+id/prayer_icon_maghrib" android:text="◓" android:textColor="#A9C9E8" android:textSize="12sp" android:layout_width="match_parent" android:layout_height="14dp" android:gravity="center" android:visibility="gone" />
                <TextView android:id="@+id/prayer_label_maghrib" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="مغرب" android:textColor="#A9C9E8" android:textSize="8sp" />
                <TextView android:id="@+id/prayer_value_maghrib" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#F2F8FF" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_time_isha" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="1dp">
                <TextView android:id="@+id/prayer_icon_isha" android:text="☾" android:textColor="#A9C9E8" android:textSize="12sp" android:layout_width="match_parent" android:layout_height="14dp" android:gravity="center" android:visibility="gone" />
                <TextView android:id="@+id/prayer_label_isha" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="عشاء" android:textColor="#A9C9E8" android:textSize="8sp" />
                <TextView android:id="@+id/prayer_value_isha" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#F2F8FF" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
