<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_row_root"
    android:layout_width="match_parent"
    android:layout_height="156dp"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="@drawable/widget_prayer_card">

    <TextView android:id="@+id/prayer_widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/ui_no_horizon" android:textColor="#F2F8FF" android:textSize="10sp" android:visibility="gone" />

    <LinearLayout android:id="@+id/prayer_widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/prayer_widget_city" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="start|center_vertical" android:maxLines="1" android:textColor="#F2F8FF" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/prayer_widget_local_date" android:layout_width="wrap_content" android:layout_height="match_parent" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:paddingStart="8dp" android:paddingEnd="8dp" android:textColor="#A9C9E8" android:textSize="15sp" />
            <TextView android:id="@+id/prayer_widget_local_time" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:minWidth="72dp" android:textColor="#56D8FF" android:textSize="28sp" android:textStyle="bold" />
            <Chronometer android:id="@+id/prayer_widget_countdown" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:minWidth="72dp" android:textColor="#FFC857" android:textSize="28sp" android:textStyle="bold" android:visibility="gone" />
            <TextView android:id="@+id/prayer_widget_current_chip" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/prayer_widget_next_box" android:layout_width="match_parent" android:layout_height="0dp" android:visibility="gone">
            <TextView android:id="@+id/prayer_widget_next_label" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/prayer_widget_times" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal" android:weightSum="8">
            <LinearLayout android:id="@+id/prayer_time_fajr" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="1dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="30dp">
                    <ImageView android:id="@+id/prayer_icon_image_fajr" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitCenter" android:visibility="gone" />
                <TextView android:id="@+id/prayer_icon_fajr" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="◒" android:textColor="#A9C9E8" android:textSize="14sp" />
                </FrameLayout>
                <TextView android:id="@+id/prayer_label_fajr" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:maxLines="1" android:text="@string/ui_fajr" android:textColor="#A9C9E8" android:textSize="14sp" />
                <TextView android:id="@+id/prayer_value_fajr" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#F2F8FF" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_time_sunrise" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="1dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="30dp">
                    <ImageView android:id="@+id/prayer_icon_image_sunrise" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitCenter" android:visibility="gone" />
                <TextView android:id="@+id/prayer_icon_sunrise" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="☀" android:textColor="#A9C9E8" android:textSize="14sp" />
                </FrameLayout>
                <TextView android:id="@+id/prayer_label_sunrise" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:maxLines="1" android:text="@string/ui_sunrise" android:textColor="#A9C9E8" android:textSize="14sp" />
                <TextView android:id="@+id/prayer_value_sunrise" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#F2F8FF" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_time_dhuhr" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="1dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="30dp">
                    <ImageView android:id="@+id/prayer_icon_image_dhuhr" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitCenter" android:visibility="gone" />
                <TextView android:id="@+id/prayer_icon_dhuhr" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="☼" android:textColor="#A9C9E8" android:textSize="14sp" />
                </FrameLayout>
                <TextView android:id="@+id/prayer_label_dhuhr" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:maxLines="1" android:text="@string/ui_dhuhr" android:textColor="#A9C9E8" android:textSize="14sp" />
                <TextView android:id="@+id/prayer_value_dhuhr" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#F2F8FF" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_time_asr" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="1dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="30dp">
                    <ImageView android:id="@+id/prayer_icon_image_asr" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitCenter" android:visibility="gone" />
                <TextView android:id="@+id/prayer_icon_asr" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="◉" android:textColor="#A9C9E8" android:textSize="14sp" />
                </FrameLayout>
                <TextView android:id="@+id/prayer_label_asr" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:maxLines="1" android:text="@string/ui_asr" android:textColor="#A9C9E8" android:textSize="14sp" />
                <TextView android:id="@+id/prayer_value_asr" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#F2F8FF" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_time_sunset" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="1dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="30dp">
                    <ImageView android:id="@+id/prayer_icon_image_sunset" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitCenter" android:visibility="gone" />
                <TextView android:id="@+id/prayer_icon_sunset" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="◓" android:textColor="#A9C9E8" android:textSize="14sp" />
                </FrameLayout>
                <TextView android:id="@+id/prayer_label_sunset" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:maxLines="1" android:text="@string/ui_sunset" android:textColor="#A9C9E8" android:textSize="14sp" />
                <TextView android:id="@+id/prayer_value_sunset" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#F2F8FF" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_time_maghrib" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="1dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="30dp">
                    <ImageView android:id="@+id/prayer_icon_image_maghrib" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitCenter" android:visibility="gone" />
                <TextView android:id="@+id/prayer_icon_maghrib" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="◒" android:textColor="#A9C9E8" android:textSize="14sp" />
                </FrameLayout>
                <TextView android:id="@+id/prayer_label_maghrib" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:maxLines="1" android:text="@string/ui_maghrib" android:textColor="#A9C9E8" android:textSize="14sp" />
                <TextView android:id="@+id/prayer_value_maghrib" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#F2F8FF" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_time_isha" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="1dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="30dp">
                    <ImageView android:id="@+id/prayer_icon_image_isha" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitCenter" android:visibility="gone" />
                <TextView android:id="@+id/prayer_icon_isha" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="☾" android:textColor="#A9C9E8" android:textSize="14sp" />
                </FrameLayout>
                <TextView android:id="@+id/prayer_label_isha" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:maxLines="1" android:text="@string/ui_isha" android:textColor="#A9C9E8" android:textSize="14sp" />
                <TextView android:id="@+id/prayer_value_isha" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#F2F8FF" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/prayer_time_midnight" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="1dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="30dp">
                    <ImageView android:id="@+id/prayer_icon_image_midnight" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="fitCenter" android:visibility="gone" />
                    <TextView android:id="@+id/prayer_icon_midnight" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="◷" android:textColor="#A9C9E8" android:textSize="14sp" />
                </FrameLayout>
                <TextView android:id="@+id/prayer_label_midnight" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:maxLines="1" android:text="@string/ui_midnight" android:textColor="#A9C9E8" android:textSize="14sp" />
                <TextView android:id="@+id/prayer_value_midnight" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#F2F8FF" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
