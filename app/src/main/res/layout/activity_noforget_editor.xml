<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F9F8"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layoutDirection="rtl"
        android:paddingStart="14dp"
        android:paddingTop="16dp"
        android:paddingEnd="14dp"
        android:paddingBottom="26dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:background="@drawable/bg_header"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="یادداشت"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="متن، نقاشی و یادآوری"
                android:textColor="#D7EFED"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/note_title"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_field"
                android:hint="عنوان یادداشت"
                android:inputType="textCapSentences"
                android:paddingHorizontal="14dp"
                android:textColor="#123D3A"
                android:textColorHint="#96A6A2"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/note_body"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_field"
                android:gravity="top|start"
                android:hint="متن یادداشت خود را اینجا بنویسید..."
                android:inputType="textCapSentences|textMultiLine"
                android:padding="14dp"
                android:textColor="#123D3A"
                android:textColorHint="#96A6A2"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="اهمیت"
                android:textColor="#667B77"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/note_priority"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_field"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <CheckBox
                android:id="@+id/note_has_due"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:buttonTint="#087C77"
                android:text="سررسید دارد"
                android:textColor="#274743" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:orientation="horizontal"
                android:layoutDirection="rtl">

                <Button
                    android:id="@+id/note_date"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:text="تاریخ"
                    android:textAllCaps="false"
                    android:textColor="#0B6E69" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="match_parent" />

                <Button
                    android:id="@+id/note_time"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:text="ساعت"
                    android:textAllCaps="false"
                    android:textColor="#0B6E69" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/note_reminder"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:buttonTint="#087C77"
                android:text="در زمان سررسید یادآوری شود"
                android:textColor="#274743" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="نقاشی و ترسیم"
                android:textColor="#0B5F5B"
                android:textSize="17sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layoutDirection="rtl">

                    <Button
                        android:id="@+id/editor_undo"
                        android:layout_width="48dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_soft_button"
                        android:minWidth="0dp"
                        android:text="↶"
                        android:textAllCaps="false"
                        android:textColor="#0B6E69"
                        android:textSize="20sp" />

                    <Space android:layout_width="6dp" android:layout_height="1dp" />

                    <Button
                        android:id="@+id/editor_redo"
                        android:layout_width="48dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_soft_button"
                        android:minWidth="0dp"
                        android:text="↷"
                        android:textAllCaps="false"
                        android:textColor="#0B6E69"
                        android:textSize="20sp" />

                    <Space android:layout_width="6dp" android:layout_height="1dp" />

                    <Button
                        android:id="@+id/clear_sketch"
                        android:layout_width="58dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_soft_button"
                        android:minWidth="0dp"
                        android:text="پاک"
                        android:textAllCaps="false"
                        android:textColor="#0B6E69"
                        android:textSize="12sp" />

                    <Space android:layout_width="10dp" android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/editor_pen_teal"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="●"
                        android:textColor="#087C77"
                        android:textSize="30sp" />
                    <TextView
                        android:id="@+id/editor_pen_orange"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="●"
                        android:textColor="#F17600"
                        android:textSize="30sp" />
                    <TextView
                        android:id="@+id/editor_pen_black"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="●"
                        android:textColor="#1B2423"
                        android:textSize="30sp" />
                    <TextView
                        android:id="@+id/editor_pen_blue"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="●"
                        android:textColor="#2457D6"
                        android:textSize="30sp" />

                    <Space android:layout_width="10dp" android:layout_height="1dp" />

                    <Button
                        android:id="@+id/editor_pen_thin"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_soft_button"
                        android:minWidth="0dp"
                        android:text="•"
                        android:textAllCaps="false"
                        android:textColor="#0B6E69"
                        android:textSize="18sp" />
                    <Button
                        android:id="@+id/editor_pen_medium"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_teal_button"
                        android:minWidth="0dp"
                        android:text="●"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                    <Button
                        android:id="@+id/editor_pen_thick"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_soft_button"
                        android:minWidth="0dp"
                        android:text="●"
                        android:textAllCaps="false"
                        android:textColor="#0B6E69"
                        android:textSize="20sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <com.ilia.advanceclock.SketchView
                android:id="@+id/note_sketch"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/save_note"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_orange_button"
            android:text="ذخیره یادداشت"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/delete_note"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_soft_button"
            android:text="حذف یادداشت"
            android:textAllCaps="false"
            android:textColor="#B64646" />

        <Button
            android:id="@+id/cancel_note"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_soft_button"
            android:text="انصراف"
            android:textAllCaps="false"
            android:textColor="#0B6E69" />
    </LinearLayout>
</ScrollView>