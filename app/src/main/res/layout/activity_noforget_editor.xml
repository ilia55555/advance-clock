<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layoutDirection="rtl"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:background="@drawable/bg_header"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="یادداشت"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="متن، نقاشی، اهمیت و آلارم"
                android:textColor="#E0F2F1"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/note_title"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_field"
                android:hint="عنوان یادداشت"
                android:inputType="textCapSentences"
                android:paddingHorizontal="14dp"
                android:textColor="?attr/appTextPrimary"
                android:textColorHint="?attr/appTextSecondary"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/note_body"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_field"
                android:gravity="top|start"
                android:hint="متن یادداشت خود را اینجا بنویسید..."
                android:inputType="textCapSentences|textMultiLine"
                android:padding="14dp"
                android:textColor="?attr/appTextPrimary"
                android:textColorHint="?attr/appTextSecondary"
                android:textSize="15sp" />

            <Spinner
                android:id="@+id/note_priority"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:layoutDirection="rtl">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="آلارم برای این یادداشت"
                    android:textColor="?attr/appTextPrimary"
                    android:textSize="15sp" />

                <Switch
                    android:id="@+id/note_alarm_enabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/note_alarm_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:orientation="horizontal"
                    android:layoutDirection="rtl">

                    <Button
                        android:id="@+id/note_date"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_field"
                        android:text="تاریخ"
                        android:textAllCaps="false"
                        android:textColor="?attr/appPrimary" />

                    <Space android:layout_width="8dp" android:layout_height="1dp" />

                    <Button
                        android:id="@+id/note_time"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_field"
                        android:text="ساعت"
                        android:textAllCaps="false"
                        android:textColor="?attr/appPrimary" />
                </LinearLayout>

                <Button
                    android:id="@+id/note_repeat"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_field"
                    android:text="بدون تکرار"
                    android:textAllCaps="false"
                    android:textColor="?attr/appPrimary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="نقاشی و ترسیم"
                android:textColor="?attr/appTextPrimary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <com.ilia.advanceclock.GestureHorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layoutDirection="rtl">

                    <ImageButton
                        android:id="@+id/editor_undo"
                        android:layout_width="48dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_soft_button"
                        android:contentDescription="قبلی"
                        android:padding="11dp"
                        android:src="@drawable/ic_md_undo"
                        android:tint="?attr/appPrimary" />

                    <Space android:layout_width="6dp" android:layout_height="1dp" />

                    <ImageButton
                        android:id="@+id/clear_sketch"
                        android:layout_width="48dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_soft_button"
                        android:contentDescription="حذف"
                        android:padding="11dp"
                        android:src="@drawable/ic_md_delete"
                        android:tint="#C44C4C" />

                    <Space android:layout_width="6dp" android:layout_height="1dp" />

                    <ImageButton
                        android:id="@+id/editor_redo"
                        android:layout_width="48dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_soft_button"
                        android:contentDescription="بعدی"
                        android:padding="11dp"
                        android:src="@drawable/ic_md_redo"
                        android:tint="?attr/appPrimary" />

                    <Space android:layout_width="6dp" android:layout_height="1dp" />

                    <ImageButton
                        android:id="@+id/editor_palette"
                        android:layout_width="48dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_soft_button"
                        android:contentDescription="پالت"
                        android:padding="11dp"
                        android:src="@drawable/ic_md_palette"
                        android:tint="?attr/appPrimary" />

                    <Space android:layout_width="8dp" android:layout_height="1dp" />

                    <Spinner
                        android:id="@+id/editor_pen_size"
                        android:layout_width="126dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_field"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <Space android:layout_width="8dp" android:layout_height="1dp" />

                    <CheckBox
                        android:id="@+id/editor_grid_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:buttonTint="?attr/appPrimary"
                        android:checked="true"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="نمایش گرید"
                        android:textColor="?attr/appTextPrimary" />
                </LinearLayout>
            </com.ilia.advanceclock.GestureHorizontalScrollView>

            <com.ilia.advanceclock.SketchView
                android:id="@+id/note_sketch"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/save_note"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_orange_button"
            android:text="ذخیره یادداشت"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/delete_note"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_soft_button"
            android:text="حذف یادداشت"
            android:textAllCaps="false"
            android:textColor="#C44C4C" />

        <Button
            android:id="@+id/cancel_note"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_soft_button"
            android:text="انصراف"
            android:textAllCaps="false"
            android:textColor="?attr/appPrimary" />
    </LinearLayout>
</ScrollView>
