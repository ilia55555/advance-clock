<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/note_editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layoutDirection="rtl"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:background="@drawable/bg_header"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/runtime_text_0015"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/layout_text_0017"
                android:textColor="#E0F2F1"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/note_title"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_field"
                android:hint="@string/runtime_text_0122"
                android:inputType="textCapSentences"
                android:paddingHorizontal="14dp"
                android:textColor="?attr/appTextPrimary"
                android:textColorHint="?attr/appTextSecondary"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/note_body"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_field"
                android:gravity="top|start"
                android:hint="@string/runtime_text_0123"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="14dp"
                android:textColor="?attr/appTextPrimary"
                android:textColorHint="?attr/appTextSecondary"
                android:textSize="15sp" />

            <Spinner
                android:id="@+id/note_priority"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:layoutDirection="rtl">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/runtime_text_0124"
                    android:textColor="?attr/appTextPrimary"
                    android:textSize="15sp" />

                <Switch
                    android:id="@+id/note_alarm_enabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/note_alarm_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:orientation="horizontal"
                    android:layoutDirection="rtl">

                    <Button
                        android:id="@+id/note_date"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_field"
                        android:text="@string/runtime_text_0014"
                        android:textAllCaps="false"
                        android:textColor="?attr/appPrimary" />

                    <Space android:layout_width="8dp" android:layout_height="1dp" />

                    <Button
                        android:id="@+id/note_time"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_field"
                        android:text="@string/runtime_text_0013"
                        android:textAllCaps="false"
                        android:textColor="?attr/appPrimary" />
                </LinearLayout>

                <Button
                    android:id="@+id/note_repeat"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_field"
                    android:text="@string/runtime_text_0029"
                    android:textAllCaps="false"
                    android:textColor="?attr/appPrimary" />

                <Switch
                    android:id="@+id/note_vibrate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_field"
                    android:paddingHorizontal="12dp"
                    android:text="@string/runtime_text_0022"
                    android:textColor="?attr/appTextPrimary" />

                <Switch
                    android:id="@+id/note_fullscreen_unlocked"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_field"
                    android:paddingHorizontal="12dp"
                    android:text="@string/runtime_text_0210"
                    android:textColor="?attr/appTextPrimary" />

                <Switch
                    android:id="@+id/note_fullscreen_locked"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_field"
                    android:paddingHorizontal="12dp"
                    android:text="@string/runtime_text_0211"
                    android:textColor="?attr/appTextPrimary" />

                <Button
                    android:id="@+id/note_sound"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_field"
                    android:text="@string/runtime_text_0125"
                    android:textAllCaps="false"
                    android:textColor="?attr/appPrimary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/layout_text_0018"
                android:textColor="?attr/appTextPrimary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <Button android:id="@+id/note_add_files" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/layout_text_0019" android:textAllCaps="false" />
                <Button android:id="@+id/note_add_app" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/layout_text_0020" android:textAllCaps="false" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="8dp"
                android:scrollbars="none">
                <LinearLayout android:id="@+id/note_attachments" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/runtime_text_0119"
                android:textColor="?attr/appTextPrimary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <com.ilia.advanceclock.GestureHorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layoutDirection="rtl">

                    <ImageButton
                        android:id="@+id/editor_undo"
                        android:layout_width="48dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_soft_button"
                        android:contentDescription="@string/layout_text_0008"
                        android:padding="11dp"
                        android:src="@drawable/ic_md_undo"
                        android:tint="?attr/appPrimary" />

                    <Space android:layout_width="6dp" android:layout_height="1dp" />

                    <ImageButton
                        android:id="@+id/clear_sketch"
                        android:layout_width="48dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_soft_button"
                        android:contentDescription="@string/runtime_text_0006"
                        android:padding="11dp"
                        android:src="@drawable/ic_md_delete"
                        android:tint="#C44C4C" />

                    <Space android:layout_width="6dp" android:layout_height="1dp" />

                    <ImageButton
                        android:id="@+id/editor_redo"
                        android:layout_width="48dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_soft_button"
                        android:contentDescription="@string/layout_text_0009"
                        android:padding="11dp"
                        android:src="@drawable/ic_md_redo"
                        android:tint="?attr/appPrimary" />

                    <Space android:layout_width="6dp" android:layout_height="1dp" />

                    <ImageButton
                        android:id="@+id/editor_palette"
                        android:layout_width="48dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_soft_button"
                        android:contentDescription="@string/layout_text_0010"
                        android:padding="11dp"
                        android:src="@drawable/ic_md_palette"
                        android:tint="?attr/appPrimary" />

                    <Space android:layout_width="8dp" android:layout_height="1dp" />

                    <Spinner
                        android:id="@+id/editor_pen_size"
                        android:layout_width="48dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_field"
                        android:spinnerMode="dropdown" />

                    <Space android:layout_width="6dp" android:layout_height="1dp" />

                    <ImageButton
                        android:id="@+id/editor_grid_toggle"
                        android:layout_width="48dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_soft_button"
                        android:contentDescription="@string/layout_text_0011"
                        android:padding="10dp"
                        android:src="@drawable/ic_grid"
                        android:tint="?attr/appPrimary" />
                </LinearLayout>
            </com.ilia.advanceclock.GestureHorizontalScrollView>

            <com.ilia.advanceclock.SketchView
                android:id="@+id/note_sketch"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/save_note"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_orange_button"
            android:text="@string/runtime_text_0120"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/delete_note"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_soft_button"
            android:text="@string/runtime_text_0121"
            android:textAllCaps="false"
            android:textColor="#C44C4C" />

        <Button
            android:id="@+id/cancel_note"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_soft_button"
            android:text="@string/runtime_text_0003"
            android:textAllCaps="false"
            android:textColor="?attr/appPrimary" />
    </LinearLayout>
</ScrollView>
