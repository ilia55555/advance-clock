<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:orientation="vertical"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/header_root"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:background="@drawable/bg_header"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layoutDirection="ltr">

            <ImageButton
                android:id="@+id/theme_toggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="دارک مود و لایت مود"
                android:padding="12dp"
                android:src="@drawable/ic_md_dark"
                android:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/header_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/header_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="تاریخ امروز"
                    android:textColor="#D9EFED"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/header_menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="منو"
                android:padding="12dp"
                android:src="@drawable/ic_md_more_vert"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:layoutDirection="rtl">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tab_clock"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center"
                    android:text="ساعت"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/clock_indicator"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="?attr/appSecondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tab_noforget"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center"
                    android:text="یادداشت‌ها"
                    android:textColor="#D6EFED"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/noforget_indicator"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="?attr/appSecondary"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/clock_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/appBackground"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/clock_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="12dp"
                android:paddingEnd="8dp"
                android:paddingBottom="92dp">

                <LinearLayout
                    android:id="@+id/alarm_composer_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ایجاد هشدار"
                        android:textColor="?attr/appTextPrimary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="تاریخ، زمان، اهمیت، تکرار و یادآوری را تنظیم کنید"
                        android:textColor="?attr/appTextSecondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:layoutDirection="rtl">

                        <Button
                            android:id="@+id/quick_alarm_time"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_field"
                            android:text="ساعت"
                            android:textAllCaps="false"
                            android:textColor="?attr/appPrimary"
                            android:textSize="16sp" />

                        <Space android:layout_width="8dp" android:layout_height="1dp" />

                        <Button
                            android:id="@+id/quick_alarm_date"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_field"
                            android:text="تاریخ"
                            android:textAllCaps="false"
                            android:textColor="?attr/appPrimary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:layoutDirection="rtl">

                        <Spinner
                            android:id="@+id/quick_alarm_priority"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_field"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />

                        <Space android:layout_width="8dp" android:layout_height="1dp" />

                        <Button
                            android:id="@+id/quick_alarm_repeat"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_field"
                            android:text="بدون تکرار"
                            android:textAllCaps="false"
                            android:textColor="?attr/appPrimary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:layoutDirection="rtl">

                        <Button
                            android:id="@+id/quick_alarm_reminders"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_field"
                            android:text="یادآوری&#10;بدون یادآوری"
                            android:textAllCaps="false"
                            android:textColor="?attr/appPrimary"
                            android:textSize="12sp" />

                        <Space android:layout_width="8dp" android:layout_height="1dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_field"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="لرزش"
                                android:textColor="?attr/appTextSecondary"
                                android:textSize="12sp" />

                            <Switch
                                android:id="@+id/quick_alarm_vibrate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true" />
                        </LinearLayout>
                    </LinearLayout>

                    <EditText
                        android:id="@+id/quick_alarm_label"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_field"
                        android:hint="برچسب؛ مثلاً صبح بخیر!"
                        android:inputType="textCapSentences"
                        android:paddingHorizontal="14dp"
                        android:textColor="?attr/appTextPrimary"
                        android:textColorHint="?attr/appTextSecondary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="عکس‌های هشدار (اختیاری، حداکثر ۲ عکس)"
                        android:textColor="?attr/appTextSecondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:layoutDirection="rtl">

                        <Button
                            android:id="@+id/quick_alarm_image1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_field"
                            android:text="افزودن عکس ۱"
                            android:textAllCaps="false"
                            android:textColor="?attr/appPrimary"
                            android:textSize="12sp" />

                        <Space
                            android:layout_width="8dp"
                            android:layout_height="1dp" />

                        <Button
                            android:id="@+id/quick_alarm_image2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_field"
                            android:text="افزودن عکس ۲"
                            android:textAllCaps="false"
                            android:textColor="?attr/appPrimary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/save_quick_alarm"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_orange_button"
                        android:text="ذخیره هشدار"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.ilia.advanceclock.TripleCalendarView
                    android:id="@+id/clock_calendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <LinearLayout
                    android:id="@+id/alerts_header"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layoutDirection="rtl">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="هشدارها"
                        android:textColor="?attr/appTextPrimary"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/add_clock_widget"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_soft_button"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:text="+ ویجت"
                        android:textAllCaps="false"
                        android:textColor="?attr/appPrimary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/alarm_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/noforget_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/appBackground"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="12dp"
                android:paddingEnd="8dp"
                android:paddingBottom="92dp">

                <com.ilia.advanceclock.TripleCalendarView
                    android:id="@+id/noforget_calendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/note_composer_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <EditText
                        android:id="@+id/quick_note_title"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_field"
                        android:hint="عنوان یادداشت"
                        android:inputType="textCapSentences"
                        android:paddingHorizontal="14dp"
                        android:textColor="?attr/appTextPrimary"
                        android:textColorHint="?attr/appTextSecondary"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/quick_note_body"
                        android:layout_width="match_parent"
                        android:layout_height="118dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_field"
                        android:gravity="top|start"
                        android:hint="متن یادداشت خود را اینجا بنویسید..."
                        android:inputType="textCapSentences|textMultiLine"
                        android:padding="14dp"
                        android:textColor="?attr/appTextPrimary"
                        android:textColorHint="?attr/appTextSecondary"
                        android:textSize="15sp" />

                    <Spinner
                        android:id="@+id/quick_note_priority"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_field"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:layoutDirection="rtl">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="آلارم برای این یادداشت"
                            android:textColor="?attr/appTextPrimary"
                            android:textSize="14sp" />

                        <Switch
                            android:id="@+id/quick_note_alarm_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/quick_note_alarm_controls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:orientation="horizontal"
                            android:layoutDirection="rtl">

                            <Button
                                android:id="@+id/quick_note_date"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_field"
                                android:text="تاریخ"
                                android:textAllCaps="false"
                                android:textColor="?attr/appPrimary" />

                            <Space android:layout_width="8dp" android:layout_height="1dp" />

                            <Button
                                android:id="@+id/quick_note_time"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_field"
                                android:text="ساعت"
                                android:textAllCaps="false"
                                android:textColor="?attr/appPrimary" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/quick_note_repeat"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_field"
                            android:text="بدون تکرار"
                            android:textAllCaps="false"
                            android:textColor="?attr/appPrimary" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/save_quick_note"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_orange_button"
                        android:text="ذخیره یادداشت"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/note_sketch_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="نقاشی و ترسیم"
                        android:textColor="?attr/appTextPrimary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <com.ilia.advanceclock.GestureHorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:fillViewport="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layoutDirection="rtl">

                            <ImageButton
                                android:id="@+id/note_undo"
                                android:layout_width="48dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_soft_button"
                                android:contentDescription="قبلی"
                                android:padding="11dp"
                                android:src="@drawable/ic_md_undo"
                                android:tint="?attr/appPrimary" />

                            <Space android:layout_width="6dp" android:layout_height="1dp" />

                            <ImageButton
                                android:id="@+id/note_clear"
                                android:layout_width="48dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_soft_button"
                                android:contentDescription="حذف"
                                android:padding="11dp"
                                android:src="@drawable/ic_md_delete"
                                android:tint="#C44C4C" />

                            <Space android:layout_width="6dp" android:layout_height="1dp" />

                            <ImageButton
                                android:id="@+id/note_redo"
                                android:layout_width="48dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_soft_button"
                                android:contentDescription="بعدی"
                                android:padding="11dp"
                                android:src="@drawable/ic_md_redo"
                                android:tint="?attr/appPrimary" />

                            <Space android:layout_width="6dp" android:layout_height="1dp" />

                            <ImageButton
                                android:id="@+id/note_palette"
                                android:layout_width="48dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_soft_button"
                                android:contentDescription="پالت"
                                android:padding="11dp"
                                android:src="@drawable/ic_md_palette"
                                android:tint="?attr/appPrimary" />

                            <Space android:layout_width="8dp" android:layout_height="1dp" />

                            <Spinner
                                android:id="@+id/pen_size_spinner"
                                android:layout_width="48dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_field"
                                android:spinnerMode="dropdown" />

                            <Space android:layout_width="6dp" android:layout_height="1dp" />

                            <ImageButton
                                android:id="@+id/grid_toggle"
                                android:layout_width="48dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_soft_button"
                                android:contentDescription="نمایش یا مخفی کردن گرید"
                                android:padding="10dp"
                                android:src="@drawable/ic_grid"
                                android:tint="?attr/appPrimary" />
                        </LinearLayout>
                    </com.ilia.advanceclock.GestureHorizontalScrollView>

                    <com.ilia.advanceclock.SketchView
                        android:id="@+id/quick_note_sketch"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layoutDirection="rtl">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="یادداشت‌ها"
                        android:textColor="?attr/appTextPrimary"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/add_noforget_widget"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_soft_button"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:text="+ ویجت"
                        android:textAllCaps="false"
                        android:textColor="?attr/appPrimary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/noforget_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/clock_fab"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="18dp"
            android:background="@drawable/bg_fab"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="+"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/note_fab"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="18dp"
            android:background="@drawable/bg_fab"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="+"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>