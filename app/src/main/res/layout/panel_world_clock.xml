<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:layoutDirection="ltr">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/appBackground"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:layoutDirection="rtl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="92dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layoutDirection="ltr">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/world_clock_title"
                    android:textColor="?attr/appTextPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/world_alarm"
                    android:layout_width="82dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_soft_button"
                    android:minWidth="0dp"
                    android:paddingHorizontal="6dp"
                    android:text="تنظیم آلارم"
                    android:textAllCaps="false"
                    android:textColor="?attr/appPrimary"
                    android:textSize="11sp" />

                <Space
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/world_add_widget"
                    android:layout_width="68dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_soft_button"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="ویجت +"
                    android:textAllCaps="false"
                    android:textColor="?attr/appPrimary"
                    android:textSize="12sp" />

                <Space
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/world_pick_reference"
                    android:layout_width="88dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_field"
                    android:minWidth="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="رفتن به تاریخ"
                    android:textAllCaps="false"
                    android:textColor="?attr/appPrimary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layoutDirection="ltr">

                <TextView
                    android:id="@+id/world_reference_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="زمان فعلی در مناطق انتخاب‌شده"
                    android:textColor="?attr/appTextSecondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/world_reference_now"
                    android:layout_width="104dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_soft_button"
                    android:minWidth="0dp"
                    android:paddingHorizontal="6dp"
                    android:text="بازگشت به اکنون"
                    android:textAllCaps="false"
                    android:textColor="?attr/appPrimary"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/world_clock_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/world_fab"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:background="@drawable/bg_fab"
        android:contentDescription="افزودن ساعت جهانی"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:text="+"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="30sp" />
</FrameLayout>
