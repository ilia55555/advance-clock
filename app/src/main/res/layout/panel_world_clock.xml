<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:fillViewport="true"
    android:layoutDirection="rtl">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ساعت جهانی"
            android:textColor="?attr/appTextPrimary"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="منطقه زمانی دلخواه را اضافه کنید؛ سه مورد اول در ویجت ساعت جهانی نمایش داده می‌شوند."
            android:textColor="?attr/appTextSecondary"
            android:textSize="13sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">
            <Spinner
                android:id="@+id/world_zone_spinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_field"
                android:paddingHorizontal="10dp" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <Button
                android:id="@+id/world_add"
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_teal_button"
                android:text="افزودن"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/world_clock_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
