<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:layoutDirection="ltr">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/appBackground"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:layoutDirection="rtl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="92dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/world_clock_title"
                android:textColor="?attr/appTextPrimary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/world_reference_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="زمان فعلی در مناطق انتخاب‌شده"
                android:textColor="?attr/appTextSecondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/world_clock_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/world_pick_reference"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:text="تبدیل تاریخ و ساعت دلخواه"
                    android:textAllCaps="false"
                    android:textColor="?attr/appPrimary" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/world_reference_now"
                    android:layout_width="110dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_soft_button"
                    android:text="بازگشت به اکنون"
                    android:textAllCaps="false"
                    android:textColor="?attr/appPrimary"
                    android:visibility="gone" />
            </LinearLayout>

            <Button
                android:id="@+id/world_add_widget"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_soft_button"
                android:text="+ افزودن ویجت ساعت جهانی"
                android:textAllCaps="false"
                android:textColor="?attr/appPrimary" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/world_fab"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:background="@drawable/bg_fab"
        android:contentDescription="افزودن ساعت جهانی"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:text="+"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="30sp" />
</FrameLayout>
