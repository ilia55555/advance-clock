<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:fillViewport="true"
    android:layoutDirection="rtl">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/world_clock_title"
            android:textColor="?attr/appTextPrimary"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/world_reference_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="زمان فعلی در مناطق انتخاب‌شده"
            android:textColor="?attr/appTextSecondary"
            android:textSize="13sp" />
        <LinearLayout
            android:id="@+id/world_clock_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/world_pick_reference"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_field"
                android:text="تبدیل تاریخ و ساعت دلخواه"
                android:textAllCaps="false"
                android:textColor="?attr/appPrimary" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <Button
                android:id="@+id/world_reference_now"
                android:layout_width="110dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_soft_button"
                android:text="بازگشت به اکنون"
                android:textAllCaps="false"
                android:textColor="?attr/appPrimary"
                android:visibility="gone" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="افزودن منطقه زمانی"
            android:textColor="?attr/appTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/world_search"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:hint="جست‌وجوی شهر، استان، کشور یا قاره"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="?attr/appTextPrimary"
            android:textColorHint="?attr/appTextSecondary" />
        <Spinner
            android:id="@+id/world_zone_spinner"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:paddingHorizontal="10dp" />
        <Button
            android:id="@+id/world_add"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_teal_button"
            android:text="افزودن ساعت انتخاب‌شده"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
