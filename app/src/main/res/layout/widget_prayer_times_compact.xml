<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="5dp"
    android:background="@drawable/widget_prayer_bg_navy">

    <LinearLayout
        android:id="@+id/prayer_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:layoutDirection="rtl"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="1dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/prayer_widget_title"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:gravity="start"
                android:text="@string/ui_prayer_times"
                android:textColor="#F2F8FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/prayer_widget_date"
                android:layout_width="match_parent"
                android:layout_height="13dp"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:textColor="#A9C9E8"
                android:textSize="8sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/prayer_widget_manage"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_prayer_chip"
            android:contentDescription="@string/ui_manage_horizons"
            android:gravity="center"
            android:text="⌖"
            android:textColor="#56D8FF"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/prayer_widget_settings"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_prayer_chip"
            android:contentDescription="@string/ui_widget_settings"
            android:padding="4dp"
            android:src="@drawable/ic_prayer_widget_settings"
            android:tint="#A9C9E8" />
    </LinearLayout>

    <ListView
        android:id="@+id/prayer_widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"
        android:overScrollMode="ifContentScrolls"
        android:scrollbarStyle="insideOverlay"
        android:scrollbars="vertical" />
</LinearLayout>
