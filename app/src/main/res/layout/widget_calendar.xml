<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/calendar_widget_prev"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_soft_button"
            android:gravity="center"
            android:text="‹"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/calendar_widget_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="5dp"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/calendar_widget_today"
            android:layout_width="58dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_soft_button"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/ui_today"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/calendar_widget_next"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_soft_button"
            android:gravity="center"
            android:text="›"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/calendar_widget_weekdays"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <TextView android:id="@+id/calendar_weekday_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="9sp" android:textStyle="bold" />
        <TextView android:id="@+id/calendar_weekday_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="9sp" android:textStyle="bold" />
        <TextView android:id="@+id/calendar_weekday_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="9sp" android:textStyle="bold" />
        <TextView android:id="@+id/calendar_weekday_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="9sp" android:textStyle="bold" />
        <TextView android:id="@+id/calendar_weekday_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="9sp" android:textStyle="bold" />
        <TextView android:id="@+id/calendar_weekday_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="9sp" android:textStyle="bold" />
        <TextView android:id="@+id/calendar_weekday_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="9sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/calendar_widget_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout android:id="@+id/calendar_week_0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layoutDirection="ltr" android:orientation="horizontal" />
        <LinearLayout android:id="@+id/calendar_week_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layoutDirection="ltr" android:orientation="horizontal" />
        <LinearLayout android:id="@+id/calendar_week_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layoutDirection="ltr" android:orientation="horizontal" />
        <LinearLayout android:id="@+id/calendar_week_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layoutDirection="ltr" android:orientation="horizontal" />
        <LinearLayout android:id="@+id/calendar_week_4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layoutDirection="ltr" android:orientation="horizontal" />
        <LinearLayout android:id="@+id/calendar_week_5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layoutDirection="ltr" android:orientation="horizontal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/calendar_selected_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="7dp">

        <TextView
            android:id="@+id/calendar_selected_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:maxLines="1"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/calendar_selected_alt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:maxLines="2"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/calendar_events_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_card"
        android:ellipsize="end"
        android:gravity="start"
        android:maxLines="3"
        android:padding="7dp"
        android:textSize="10sp" />

    <ListView
        android:id="@+id/calendar_prayer_list"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="4dp"
        android:background="@android:color/transparent"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"
        android:scrollbars="none" />
</LinearLayout>
