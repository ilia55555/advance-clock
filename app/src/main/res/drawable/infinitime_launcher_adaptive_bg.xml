<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background always fills the launcher mask, while the provided artwork
         stays inside the safe 72dp adaptive-icon viewport. -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315"
                android:startColor="#0349BA"
                android:endColor="#1CC8E8" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/infinitime_launcher"
        android:width="72dp"
        android:height="72dp"
        android:gravity="center" />
</layer-list>
