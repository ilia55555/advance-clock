    <style name="Theme.AdvanceClock.Emerald.Light" parent="Theme.AdvanceClock.Base.Light"><item name="android:colorAccent">#2F7D5B</item><item name="appPrimary">#2F7D5B</item></style>
    <style name="Theme.AdvanceClock.Emerald.Dark" parent="Theme.AdvanceClock.Base.Dark"><item name="android:colorAccent">#6BC79A</item><item name="appPrimary">#6BC79A</item></style>
    <style name="Theme.AdvanceClock.Coral.Light" parent="Theme.AdvanceClock.Base.Light"><item name="android:colorAccent">#CB5F47</item><item name="appPrimary">#CB5F47</item></style>
