<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.AdvanceClock.FlatButton" parent="android:style/Widget.Material.Button">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="Theme.AdvanceClock.Base.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:buttonStyle">@style/Widget.AdvanceClock.FlatButton</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">?attr/appPrimary</item>
        <item name="android:navigationBarColor">#F4F9F8</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#F4F9F8</item>
        <item name="appSecondary">#C64F79</item>
        <item name="appSurface">#FFFFFF</item>
        <item name="appField">#F3F7F7</item>
        <item name="appBackground">#F4F9F8</item>
        <item name="appTextPrimary">#173F3B</item>
        <item name="appTextSecondary">#758783</item>
        <item name="appBorder">#DCE8E6</item>
    </style>

    <style name="Theme.AdvanceClock.Base.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:buttonStyle">@style/Widget.AdvanceClock.FlatButton</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">?attr/appPrimary</item>
        <item name="android:navigationBarColor">#0F1214</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#0F1214</item>
        <item name="appSecondary">#E888A8</item>
        <item name="appSurface">#171A1C</item>
        <item name="appField">#22272A</item>
        <item name="appBackground">#0F1214</item>
        <item name="appTextPrimary">#F2F5F4</item>
        <item name="appTextSecondary">#AFBCB8</item>
        <item name="appBorder">#343D3A</item>
    </style>

    <style name="Theme.AdvanceClock.Teal.Light" parent="Theme.AdvanceClock.Base.Light"><item name="android:colorAccent">#087C77</item><item name="appPrimary">#087C77</item></style>
    <style name="Theme.AdvanceClock.Teal.Dark" parent="Theme.AdvanceClock.Base.Dark"><item name="android:colorAccent">#38AAA4</item><item name="appPrimary">#38AAA4</item></style>
    <style name="Theme.AdvanceClock.Sapphire.Light" parent="Theme.AdvanceClock.Base.Light"><item name="android:colorAccent">#2563A6</item><item name="appPrimary">#2563A6</item></style>
    <style name="Theme.AdvanceClock.Sapphire.Dark" parent="Theme.AdvanceClock.Base.Dark"><item name="android:colorAccent">#68A7DE</item><item name="appPrimary">#68A7DE</item></style>
    <style name="Theme.AdvanceClock.Violet.Light" parent="Theme.AdvanceClock.Base.Light"><item name="android:colorAccent">#6D4CC4</item><item name="appPrimary">#6D4CC4</item></style>
