<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AdvanceClock" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#006F6B</item>
        <item name="android:navigationBarColor">#F4F9F8</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">#087C77</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F4F9F8</item>
    </style>

    <style name="Theme.AdvanceClock.Dialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#087C77</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>
</resources>
