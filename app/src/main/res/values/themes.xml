    <style name="OverlaySecondaryTealDark"><item name="appSecondary">#38AAA4</item></style>
    <style name="OverlaySecondarySapphireLight"><item name="appSecondary">#2563A6</item></style>
    <style name="OverlaySecondarySapphireDark"><item name="appSecondary">#68A7DE</item></style>
    <style name="OverlaySecondaryVioletLight"><item name="appSecondary">#6D4CC4</item></style>
    <style name="OverlaySecondaryVioletDark"><item name="appSecondary">#A58AE8</item></style>
    <style name="OverlaySecondaryEmeraldLight"><item name="appSecondary">#2F7D5B</item></style>
    <style name="OverlaySecondaryEmeraldDark"><item name="appSecondary">#6BC79A</item></style>
    <style name="OverlaySecondaryCoralLight"><item name="appSecondary">#CB5F47</item></style>
    <style name="OverlaySecondaryCoralDark"><item name="appSecondary">#F08B74</item></style>
    <style name="OverlaySecondaryRoseLight"><item name="appSecondary">#C64F79</item></style>
    <style name="OverlaySecondaryRoseDark"><item name="appSecondary">#E888A8</item></style>
    <style name="OverlaySecondaryAmberLight"><item name="appSecondary">#B7791F</item></style>
    <style name="OverlaySecondaryAmberDark"><item name="appSecondary">#E2B05A</item></style>
