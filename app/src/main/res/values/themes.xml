    <style name="OverlaySecondaryIndigoDark"><item name="appSecondary">#8E9BEA</item></style>

    <style name="OverlayAdvanceClockModal">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.42</item>
        <item name="android:windowMinWidthMajor">94%</item>
        <item name="android:windowMinWidthMinor">94%</item>
        <item name="android:windowNoTitle">true</item>
