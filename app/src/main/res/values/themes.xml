        <item name="android:windowBackground">#0F1214</item>
        <item name="appPrimary">#005FA8</item>
        <item name="appSecondary">#36BFEC</item>
        <item name="appSurface">#171A1C</item>
        <item name="appField">#22272A</item>
        <item name="appBackground">#0F1214</item>
        <item name="appTextPrimary">#F2F5F4</item>
        <item name="appTextSecondary">#AFBCB8</item>
        <item name="appBorder">#343D3A</item>
    </style>

    <style name="Theme.AdvanceClock.Palette0.Light" parent="Theme.AdvanceClock.Base.Light">
        <item name="android:colorAccent">#1E2A38</item>
        <item name="appPrimary">#D96B43</item>
