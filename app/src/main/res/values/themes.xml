<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AdvanceClock" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#05070D</item>
        <item name="android:navigationBarColor">#05070D</item>
        <item name="android:colorAccent">#38BDF8</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.AdvanceClock.Dialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#38BDF8</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>
</resources>
